{
    "name": "liberusoftware/ecommerce-customer-accounts-filament",
    "description": "The privacy desk: a Filament panel over Customer Accounts' privacy requests, their participants including the silent ones, the participant registry, failed claim attempts and saved lists.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": ["laravel", "filament", "ecommerce", "privacy", "gdpr", "accounts", "liberu"],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-customer-accounts"
        }
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.6",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-customer-accounts": "^0.1",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.7",
        "livewire/livewire": "^4.2",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\CustomerAccounts\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\CustomerAccounts\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-customer-accounts-filament"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
